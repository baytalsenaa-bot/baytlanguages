# Supabase — from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_, never import outside app/api/** or lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used to build verification links embedded in QR codes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number in international format, no leading +, no spaces (e.g. 201234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=
